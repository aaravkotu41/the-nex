{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "The Nex",
  "version": "0.3.0",
  "identifier": "com.thenex.gui",
  "build": {
    "frontendDist": "../../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "The Nex",
        "width": 1180,
        "height": 760,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "theme": "Dark",
        "backgroundColor": "#060914"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png", "icons/icon.ico", "icons/icon.icns"]
  }
}
